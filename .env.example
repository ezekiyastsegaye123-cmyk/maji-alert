# ==============================================================================
# Maji Alert — Environment Configuration
# ==============================================================================

# Server Port
PORT=3000

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# MongoDB Connection URI (for prediction query/audit logging)
MONGODB_URI=mongodb://127.0.0.1:27017/maji_alert

# Python Runtime & ML Service Path
# Ensure this points to the virtualenv with dependencies (scipy, scikit-learn, netCDF4, pandas, joblib)
PYTHON_EXECUTABLE=./venv/bin/python
ML_SERVICE_PATH=./predict_service.py

# Execution Safeguards
ML_TIMEOUT_MS=45000
MAX_CONCURRENT_ML_JOBS=3

# Default operational projection year (Borana Zone forward forecasting)
DEFAULT_YEAR=2026

# CORS Allowed Origin ('*' for development or 'https://your-domain.com')
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
