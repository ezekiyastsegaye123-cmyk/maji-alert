# ==============================================================================
# FRDASCR — Environment Configuration
# ==============================================================================

# Server Port
PORT=3000

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# MongoDB Connection URI (for prediction query/audit logging)
MONGODB_URI=mongodb://127.0.0.1:27017/frdascr

# Persistent Python FastAPI ML Microservice URL
ML_SERVICE_URL=http://127.0.0.1:8000

# HTTP Request Timeout for Python ML Service (in milliseconds)
ML_REQUEST_TIMEOUT_MS=10000

# Optional Subprocess Fallback (Legacy)
PYTHON_EXECUTABLE=./venv/bin/python
ML_SERVICE_PATH=./predict_service.py
ML_TIMEOUT_MS=45000
MAX_CONCURRENT_ML_JOBS=3

# Default operational projection year (Borana Zone forward forecasting)
DEFAULT_YEAR=2026

# CORS Allowed Origin ('*' for development or 'https://your-domain.com')
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
